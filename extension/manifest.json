{
  "manifest_version": 3,
  "name": "SentinelPE (research prototype)",
  "version": "0.1.0",
  "description": "Local-first static analysis of Windows PE files you select. Uploads only with your consent. Research prototype; not antivirus.",
  "action": { "default_title": "Open SentinelPE" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
