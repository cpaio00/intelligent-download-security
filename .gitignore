# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# Node / browser extension tooling
node_modules/
dist/
build/
coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Local runtime data and temporary files
*.log
tmp/
temp/
uploads/
quarantine/
sandbox-output/

# Datasets, model weights, and generated artefacts
datasets/
data/private/
models/*.pt
models/*.pth
models/*.onnx
models/*.pkl
models/*.joblib
*.h5
*.keras

# Keep explicitly documented placeholders
!.gitkeep

# Feasibility kit outputs (generated locally; never commit binaries, matrices or models)
feasibility/corpus/
feasibility/variants/
feasibility/large/
feasibility/compact_models/
feasibility/results/
feasibility/equivalence/*.json
!feasibility/equivalence/package.json
feasibility/equivalence/*.txt
feasibility/equivalence/*.npy
feasibility/*.npy
feasibility/*.dat
feasibility/full_model.txt
feasibility/*_rows.json

# Generated models (never commit; real models are rebuilt from the pipeline)
extension/model/*.json
dev_models/
ml/out/
